LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-5.5
PORT=3000

# Legacy aliases still work as the main LLM config during migration.
# LLM_BACKUP_API_KEY=
# LLM_BACKUP_BASE_URL=
# LLM_BACKUP_MODEL_ID=

# Better Auth stores only account/session data in Neon.
AUTH_DATABASE_URL=
# DATABASE_URL= can also be used for the previous Neon connection.
AUTH_DATABASE_SCHEMA=auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
