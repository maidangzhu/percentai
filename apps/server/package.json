{
  "name": "percent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run auth:generate && tsx watch src/index.ts",
    "test": "tsx --test --test-concurrency=1 --experimental-test-module-mocks $(find src -name '*.test.ts' -type f)",
    "start": "node dist/index.js",
    "build": "pnpm run auth:generate && tsc && mkdir -p dist/generated && cp -R src/generated/. dist/generated/ && rm -f dist/index.js",
    "auth:db:push": "prisma db push --config prisma-auth.config.ts",
    "auth:generate": "prisma generate --config prisma-auth.config.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.11",
    "@earendil-works/pi-ai": "^0.75.4",
    "@hono/node-server": "^2.0.3",
    "@neondatabase/serverless": "^1.1.0",
    "@percent/runtime": "workspace:*",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "better-auth": "^1.6.11",
    "dotenv": "^17.4.2",
    "hono": "^4.12.21",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
