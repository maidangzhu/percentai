# Vite env vars for the Tauri client.
# Copy to .env (gitignored) and adjust for your dev setup.

# Base URL of the Hono backend (apps/server).
#   - Dev (vite dev) default: http://localhost:3000
#   - Prod (vite build) default: https://api.thepercentai.com
#   - Setting this overrides both.
VITE_API_BASE_URL=http://localhost:3000

# Landing page URL — opened via Tauri shell.open in the system browser.
#   Default: https://thepercentai.com
VITE_LANDING_URL=https://thepercentai.com
